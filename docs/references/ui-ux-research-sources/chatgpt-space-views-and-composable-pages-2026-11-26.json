    {
      "id": "chatgpt-space-space-vs-project",
      "title": "Separate organizational contexts",
      "description": "Group related objects without conflating a shared content space and a conversation project.",
      "acceptance_tests": "Test membership, access and movement independently.",
      "source_id": "openai-space-help",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-object-views",
      "title": "Object collections and facets",
      "description": "Separate ownership, access, object type, origin and activity from hierarchy.",
      "acceptance_tests": "Test shared-space indirect access, empty results, filters and permissions.",
      "source_id": "openai-space-help",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-block-editor",
      "title": "Composable page / block editor",
      "description": "Use searchable slash menu for content, references and interactive tools; create nested page or link existing page.",
      "acceptance_tests": "Test keyboard, touch, focus, insert/reorder, deletion and reference identity.",
      "source_id": "openai-space-pages",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-width-controls",
      "title": "Per-block table width and fit",
      "description": "Normal, Flexible, Full width and readability/equal columns. Do not infer exact sizes.",
      "acceptance_tests": "Test narrow viewport, overflow, fit and screen reader headers.",
      "source_id": "openai-space-pages",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-contextual-ai",
      "title": "Contextual AI and scoped edits",
      "description": "Side chat for broad work; selected text, inline mentions and comments for scoped work. Review proposals before acceptance.",
      "acceptance_tests": "Test scope, undo/review, permission, cancellation, errors, keyboard.",
      "source_id": "openai-space-agents",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-recurring-work",
      "title": "Verified recurring updates",
      "description": "Distinguish a generated tracker from actual scheduled execution; verify saved task and run. Keep Updated unavailable at launch per guide.",
      "acceptance_tests": "Test task enablement, next run, freshness, source and failure.",
      "source_id": "openai-space-agents",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-adaptive-ui",
      "title": "Intelligent UI / generated interface",
      "description": "Choose text, cards, forms, charts or interactive output based on need; state persistence varies by experience and chat.",
      "acceptance_tests": "Test fallback text, state reload, control semantics, contrast and reduced motion.",
      "source_id": "openai-intelligent-ui",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-visualization-lifecycle",
      "title": "Interactive visualization vs persistent app",
      "description": "Visualization is generally snapshot; sites are a distinct option. Show data context, labels, accessibility and simpler fallback on failure.",
      "acceptance_tests": "Test keyboard, data table, units, blank/loading/error and export.",
      "source_id": "openai-visualizations",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-search",
      "title": "Unified content search",
      "description": "Search existing objects by type, with permission boundaries; Ctrl/Cmd+K. Not web search.",
      "acceptance_tests": "Test keyboard, archived vs deleted/locked, access and filter reset.",
      "source_id": "openai-global-search",
      "classification": "product evidence / derived acceptance tests",
      "date": "2026-11-26"
    },
    {
      "id": "chatgpt-space-mobile-navigation",
      "title": "Customizable mobile navigation",
      "description": "Home and Explore separate frequent work from discovery; pin/unpin/replace shortcuts.",
