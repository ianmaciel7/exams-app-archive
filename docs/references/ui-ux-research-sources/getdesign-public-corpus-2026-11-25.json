  "principles": [
    {
      "id": "semantic-token-references",
      "summary": "Use named roles and references instead of duplicated literals; validate token resolution and contrast.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "surface-ladder",
      "summary": "Use ordered surfaces and optional hairline edges instead of indiscriminate shadows; verify separation in each theme and high contrast.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "type-hierarchy",
      "summary": "Assign typography roles with family, size, weight, line height and tracking; validate fallbacks, zoom and reflow.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "component-variants",
      "summary": "Specify purpose, geometry, token references, variants and states; test keyboard, touch, focus, disabled and error independently.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "layout-responsive",
      "summary": "Define grid, density, breakpoints and collapse strategy; test actual narrow viewports rather than infer from desktop.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "visual-restraint",
      "summary": "Use intentional accent roles, imagery and depth appropriate to content; avoid applying marketing hero defaults to application workspaces.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "agent-ready-doc",
      "summary": "Use compact structured tokens plus prose rules and linked component contracts; verify schema and implementation, not merely visual resemblance.",
      "category": "cross-indexed practice, not new normative rule"
    },
    {
      "id": "evidence-boundaries",
      "summary": "Separate observed, inferred, recommended and missing; record source, date, scope and known gaps; do not claim product behavior from marketing screenshots.",
      "category": "cross-indexed practice, not new normative rule"
    }
  ],
